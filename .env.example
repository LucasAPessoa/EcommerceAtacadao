# Informações da API
PROJECT_NAME=E-Commerce API
VERSION=1.0.0

# Banco de Dados
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ecommerce_db
# Neon: use a URL com ?ssl=require (não sslmode/channel_binding).
# Pool: local = queue (padrão). Vercel/serverless: DB_POOL_MODE=null,
# e com endpoint Neon -pooler (PgBouncer): DB_PGBOUNCER_COMPAT=true.
# DB_POOL_MODE=queue
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=-1
# DB_POOL_TIMEOUT_SECONDS=30
# DB_PGBOUNCER_COMPAT=false

# Segurança
SECRET_KEY=your-super-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_SECRET_KEY=your-refresh-secret-key-here-change-in-production
STOCK_RESERVATION_MINUTES=15

# Integração de Frete (Melhor Envio) - https://docs.melhorenvio.com.br
MELHOR_ENVIO_TOKEN=your-melhor-envio-token-here
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_USER_AGENT=EcommerceAtacadao/1.0
STORE_ORIGIN_ZIP_CODE=01001-000

# Mercado Pago Checkout Pro hospedado. Use credenciais TEST no sandbox; a URL
# de notificação deve ser pública em HTTPS e a assinatura vem do painel MP.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_NOTIFICATION_URL=
MERCADO_PAGO_FRONTEND_BASE_URL=
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
# Envia expiration_time (PT{n}M = tempo restante da reserva) na criação da Order, para o
# link não sobreviver à reserva. Limites do campo NÃO são documentados para Checkout Pro:
# valide no sandbox antes do deploy; false desliga sem mudar código.
MERCADO_PAGO_ORDER_EXPIRATION_ENABLED=true
# Janela (horas) e máximo de tentativas para repetir cancelamentos remotos que falharam.
MERCADO_PAGO_CANCEL_RETRY_HOURS=24
MERCADO_PAGO_CANCEL_MAX_ATTEMPTS=8
# Tolerância (s) após o vencimento da reserva antes de expirar o pedido (Order remota pode viver mais).
MERCADO_PAGO_EXPIRATION_GRACE_SECONDS=120
# Token do endpoint POST /api/v1/internal/jobs/payment-maintenance (Bearer). Vazio = 404.
MAINTENANCE_JOB_TOKEN=

# Origens do navegador autorizadas, separadas por vírgula. Nunca use * com credenciais.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Rate limiting distribuído (opcional). Sem URL e token a API opera fail-open
# (com warning na inicialização); configure ambos em produção.
# Na Vercel: TRUST_PROXY_HEADERS=true e CLIENT_IP_HEADER=x-real-ip. Atrás de proxy
# com TRUST_PROXY_HEADERS=false todos os clientes caem no IP do proxy (bucket global).
# Sem CLIENT_IP_HEADER, usa-se o item mais à direita do X-Forwarded-For.
# Opção A (Redis TCP, tem precedência): redis:// ou rediss://user:senha@host:porta
# Também aceita a env STORAGE_REDIS_URL (integração Redis Cloud da Vercel).
RATE_LIMIT_REDIS_URL=
# Opção B (Redis REST/Upstash): usada só se a opção A estiver vazia.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
RATE_LIMIT_TRUST_PROXY_HEADERS=false
RATE_LIMIT_CLIENT_IP_HEADER=
RATE_LIMIT_FAILURE_COOLDOWN_SECONDS=30
MAX_REQUEST_BODY_BYTES=1048576
