# Informações da API
PROJECT_NAME=E-Commerce API
VERSION=1.0.0

# Banco de Dados
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ecommerce_db
# Neon: use a URL com ?ssl=require (não sslmode/channel_binding).

# Segurança
SECRET_KEY=your-super-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_SECRET_KEY=your-refresh-secret-key-here-change-in-production
STOCK_RESERVATION_MINUTES=15

# Integração de Frete (Melhor Envio) - https://docs.melhorenvio.com.br
MELHOR_ENVIO_TOKEN=your-melhor-envio-token-here
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_USER_AGENT=EcommerceAtacadao/1.0
STORE_ORIGIN_ZIP_CODE=01001-000

# Mercado Pago Checkout Pro hospedado. Use credenciais TEST no sandbox; a URL
# de notificação deve ser pública em HTTPS e a assinatura vem do painel MP.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_NOTIFICATION_URL=
MERCADO_PAGO_FRONTEND_BASE_URL=
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com

# Origens do navegador autorizadas, separadas por vírgula. Nunca use * com credenciais.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
